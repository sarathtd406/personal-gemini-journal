rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection document
    match /test/connection {
      allow read: if isSignedIn();
    }

    // User private journals
    match /users/{userId}/journals/{journalId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && isValidId(journalId)
                    && request.resource.data.userId == userId
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 500
                    && request.resource.data.summary is string;
      allow update: if isOwner(userId)
                    && isValidId(journalId)
                    && request.resource.data.userId == userId;
      allow delete: if isOwner(userId) && isValidId(journalId);
    }

    // User private weekly reflections
    match /users/{userId}/reflections/{reflectionId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && isValidId(reflectionId)
                    && request.resource.data.userId == userId;
      allow update: if isOwner(userId)
                    && isValidId(reflectionId)
                    && request.resource.data.userId == userId;
      allow delete: if isOwner(userId) && isValidId(reflectionId);
    }
  }
}
